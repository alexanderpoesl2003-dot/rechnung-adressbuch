{
  "name": "rechnung-adressbuch",
  "version": "0.5.3",
  "description": "Rechnungs- und Adressbuch-Desktopanwendung mit mehreren Absenderprofilen",
  "main": "src/main/main.js",
  "author": "Alexander Pösl",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "prep:win-native": "node scripts/fetch-win-native.js",
    "dist": "npm run prep:win-native && electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "call-bind-apply-helpers": "^1.0.2",
    "electron-updater": "^6.3.9",
    "iconv-lite": "^0.6.3",
    "nodemailer": "^10.0.9",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.poesl.rechnung-adressbuch",
    "productName": "AP Rechnungstool",
    "asar": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "alexanderpoesl2003-dot",
      "repo": "rechnung-adressbuch",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png",
      "artifactName": "AP-Rechnungstool-Setup-${version}.${ext}",
      "signtoolOptions": {
        "publisherName": "Alexander Pösl"
      }
    },
    "mac": {
      "icon": "assets/icons/icon.png",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
